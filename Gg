local function createSlider(parent, text, minVal, maxVal, defaultVal, decimals, callback)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(0, 335, 0, 50)
	row.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
	row.Parent = parent
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 7)

