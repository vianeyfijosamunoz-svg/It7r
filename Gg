lplr.CharacterAdded:Connect(function(newChar)
	char = newChar
	hrp = newChar:WaitForChild("HumanoidRootPart")
	undergroundTargetCFrame = nil
	ueTargetCFrame = nil
	table.clear(savedCollisions)

	if hasMovementModeActive() or config.MiscNoClip then
		applyNoClip(newChar)
	end

	task.defer(function()
		local hum = newChar:FindFirstChildWhichIsA("Humanoid")
		if hum then
			if config.WalkSpeedEnabled then
				hum.WalkSpeed = config.WalkSpeedVal
			end
			if config.JumpPowerEnabled then
				hum.UseJumpPower = true
				hum.JumpPower = config.JumpPowerVal
			end
		end
		if config.FovChangerEnabled then
			applyFov()
		end
	end)
end)

