    local function DeviceSpam()
        device_cancel += 1
        local token = device_cancel
        task.spawn(function()
            local list = {"Desktop", "Mobile", "Console", "VR"}
            local last = states.spoofer_state.device
            while states.spoofer_state.device_spam and token == device_cancel do
                local new
                repeat new = list[math.random(1, #list)] until new ~= last
                states.spoofer_state.device = new
                last = new
                SetDevice(false)
                task.wait(math.max(states.spoofer_state.spam_rate, 2.0))
            end
            SetDevice(true)
        end)
    end

