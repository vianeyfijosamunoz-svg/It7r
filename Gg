		if updateUndergroundVisual then updateUndergroundVisual(false) end
		config.UeBlockHit = true
		if updateUeBlockHitVisual then updateUeBlockHitVisual(true) end
		config.WallCheck = true
		config.ShowFov = true
		config.FovRadius = 180
		config.FovColorIndex = 1
		config.HitChance = 100
		config.MaxDistance = 500
		config.BodyPartIndex = 1
