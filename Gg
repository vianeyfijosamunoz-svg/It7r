    local ScreenGui = Instance.new("ScreenGui", CoreGui)
    local ManipLabel = Instance.new("TextLabel", ScreenGui)
    ManipLabel.Size = UDim2.new(0, 500, 0, 22)
    ManipLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
    ManipLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    ManipLabel.BackgroundTransparency = 1
    ManipLabel.TextColor3 = Color3.fromRGB(0, 170, 255)
    ManipLabel.TextScaled = false
    ManipLabel.TextSize = 16
    ManipLabel.Font = Enum.Font.GothamBold
    ManipLabel.Text = ""
    ManipLabel.TextStrokeTransparency = 0.4

    local tickCount = 0

    runS.RenderStepped:Connect(function()
        if not getgenv().SilentAimEnabled then 
            activeTargetPos = nil
        else
            local bestHead = nil
            local shortestDist = 9e9
            local screenCenter = Camera.ViewportSize / 2

            for _, plr in pairs(Players:GetPlayers()) do
                local char = plr.Character
                if char and isEnemy(plr) then
                    local head = char:FindFirstChild("Head")
                    if head then
                        local distFromMe = (head.Position - Camera.CFrame.Position).Magnitude
                        local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position)
                        local fovDist = (Vector2.new(headPos.X, headPos.Y) - screenCenter).Magnitude

                        if headOnScreen and distFromMe <= SilentMaxDistance then
                            if fovDist < shortestDist then
                                local valid = getValidHead(char)
                                if valid then 
                                    shortestDist = fovDist
                                    bestHead = valid 
                                end
                            end
                        end
                    end
                end
            end
            
            activeTargetPos = bestHead and bestHead.Position or nil
        end

        if not getgenv().Config.Enabled then 
            ManipLabel.Text = ""
            return 
        end

        updateDeflection()
        local targetPlayer, targetRoot, targetHead = getClosestTarget()
        local desyncCF = nil
        local isDeflecting = targetPlayer and deflecting[targetPlayer]

        if isDeflecting and KatanaFlashEnabled then
            ManipLabel.Text = "RAZEZ.WIN: KATANA FLASH (VOID)"
            local t = tick()
            local farPos = Vector3.new(
                math.sin(t * 50) * 5000000,
                3000000 + math.cos(t * 40) * 2000000,
                math.cos(t * 50) * 5000000
            )
            desyncCF = CFrame.new(farPos)
            if lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart") then
                local myRoot = lplr.Character.HumanoidRootPart
                local oldCF = myRoot.CFrame
                local oldVel = myRoot.Velocity
                local oldRotVel = myRoot.RotVelocity
                myRoot.CFrame = desyncCF
                runS:BindToRenderStep("__restore", 101, function()
                    if myRoot then
                        myRoot.CFrame = oldCF
                        myRoot.Velocity = oldVel
                        myRoot.RotVelocity = oldRotVel
                    end
                    runS:UnbindFromRenderStep("__restore")
                end)
            end
            return
        end

        if targetRoot and targetHead and targetPlayer then
            CurrentTarget = targetPlayer

            if RageMode == "GUN" or RageMode == "MELE" then
                local angle = tick() * 5000000 * 0.08
                desyncCF = targetRoot.CFrame * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, 3)
                ManipLabel.Text = "RAZEZ.WIN: KILLING " .. string.upper(targetPlayer.Name)
            elseif RageMode == "KNIFE" then
                local lateral = math.sin(tick() * 8) * 5
                desyncCF = targetRoot.CFrame * CFrame.new(lateral, 0, 2)
                ManipLabel.Text = "RAZEZ.WIN: KILLING " .. string.upper(targetPlayer.Name)
            elseif RageMode == "BAITING SYSTEM" then
                local angle = tick() * 50000000 * 0.05
                desyncCF = targetRoot.CFrame * CFrame.Angles(0, angle, 0) * CFrame.new(0, 500000, 5000000)
                ManipLabel.Text = "BAITING " .. string.upper(targetPlayer.Name)
            end
        else
            CurrentTarget = nil
            ManipLabel.Text = "RAZEZ.WIN: VOID HIDE"
            if lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart") then
                local farPos = Vector3.new(
                    math.sin(tick() * 3) * 5000000,
                    2000000 + math.cos(tick() * 2) * 1000000,
                    math.cos(tick() * 3) * 5000000
                )
                desyncCF = CFrame.new(farPos)
            end
        end

        if desyncCF and lplr.Character then
            local myRoot = lplr.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local oldCF = myRoot.CFrame
                local oldVel = myRoot.Velocity
                local oldRotVel = myRoot.RotVelocity
                myRoot.CFrame = desyncCF
                runS:BindToRenderStep("__restore", 101, function()
                    if myRoot then
                        myRoot.CFrame = oldCF
                        myRoot.Velocity = oldVel
                        myRoot.RotVelocity = oldRotVel
                    end
                    runS:UnbindFromRenderStep("__restore")
                end)
            end
        end

        if not targetPlayer or not targetHead or not targetRoot then return end
        if isDeflecting and KatanaFlashEnabled then return end
        if not lplr.Character or not lplr.Character:FindFirstChild("HumanoidRootPart") then return end
        if not FighterController or not FighterController.LocalFighter then return end
        local item = FighterController.LocalFighter.EquippedItem
        if not item then return end
        if tick() - lastFire < getgenv().Config.FireRate then return end
        lastFire = tick()
        local originPos = desyncCF and desyncCF.Position or targetRoot.Position
        local targetPos = targetHead.Position
        local aimCF = CFrame.lookAt(originPos, targetPos)
        local targetCF = targetHead.CFrame
        local randomOffset = Vector3.new(
            (math.random() - 0.5) * 0.1,
            (math.random() - 0.5) * 0.1,
            (math.random() - 0.5) * 0.1
        )
        local aimedPos = targetPos + randomOffset
        local objSpaceHeadOffset = targetHead.CFrame:ToObjectSpace(CFrame.new(aimedPos))
        local cameradata = {}
        cameradata[utf8.char(1)] = {
            [utf8.char(0)] = util:EncodeCFrame(aimCF),
            [utf8.char(1)] = util:EncodeCFrame(targetCF),
            [utf8.char(2)] = targetHead,
            [utf8.char(3)] = util:EncodeCFrame(objSpaceHeadOffset)
        }
        pcall(function()
            repS.Remotes.Replication.Fighter.UseItem:FireServer(
                item:Get("ObjectID"),
                enum:ToEnum("StartShooting"),
                cameradata,
                nil
            )
        end)
    end)

    local old
    old = hookmetamethod(game, "__index", newcclosure(function(self, idx)
        if getgenv().SilentAimEnabled and activeTargetPos and not checkcaller() and idx == "ViewportSize" and self == Camera then
            local pos, on = Camera:WorldToViewportPoint(activeTargetPos)
            if on then return Vector2.new(pos.X * 2, pos.Y * 2) end
        end
        return old(self, idx)
    end))

    UserInputService.JumpRequest:Connect(function()
        if getgenv().InfiniteJumpEnabled and LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)

    RunService.RenderStepped:Connect(function(dt)
        tickCount = tickCount + 1

        if AimbotEnabled then
            local targetPlayer = select(1, getClosestTarget())
            if targetPlayer and targetPlayer.Character then
                local head = targetPlayer.Character:FindFirstChild("Head") or targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if head then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
                end
            end
        end

        if OrbitActive then
            local target = nil
            for _, p in ipairs(Players:GetPlayers()) do if isEnemy(p) then target = p break end end
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = target.Character.HumanoidRootPart
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    local angle = (tickCount * (OrbitSpeed * 0.05)) * OrbitAngle
                    myRoot.CFrame = hrp.CFrame * CFrame.Angles(0, angle, 0) * CFrame.new(0, OrbitHeight, OrbitStuds)
                end
            end
        end

        if getgenv().SpinbotEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(getgenv().SpinbotSpeed), 0)
        end

        if AntiAimEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            local yaw = AntiAimYaw
            local pitch = AntiAimPitch
            if AntiAimMode == "Spin" then
                yaw = (tickCount * AntiAimSpinSpeed) % 360
            elseif AntiAimMode == "Jitter" then
                yaw = AntiAimYaw + math.random(-AntiAimJitter, AntiAimJitter)
            elseif AntiAimMode == "Down" then
                pitch = 89
            end
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(math.rad(pitch), math.rad(yaw), 0)
        end
    end)

    RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp then return end
        if getgenv().HipHeightEnabled then hum.HipHeight = getgenv().HipHeightValue end
        if getgenv().CharTransparencyEnabled then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.Transparency = getgenv().CharTransparencyValue
                elseif part:IsA("Decal") then
                    part.Transparency = getgenv().CharTransparencyValue
                end
            end
        end
        if getgenv().NoCollisionEnabled or getgenv().NoclipEnabled then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
        if getgenv().GravityEnabled then
            workspace.Gravity = getgenv().GravityValue
        else
            workspace.Gravity = defaultGravity
        end
        if getgenv().SpeedBoostEnabled then
            local moveDir = hum.MoveDirection
            if moveDir.Magnitude > 0 then
                hrp.AssemblyLinearVelocity = Vector3.new(
                    moveDir.X * getgenv().SpeedBoostValue,
                    hrp.AssemblyLinearVelocity.Y,
                    moveDir.Z * getgenv().SpeedBoostValue
                )
            end
        end
    end)

