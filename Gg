local function applyPreset(presetName)
	if presetName == "Legit Orbit" then
		setUeCounterState(false)
		config.OrbitRadius = 7
		config.OrbitSpeed = 5
		config.OrbitHeightOffset = 0.5
		config.OrbitBlockHit = true
		config.TargetPriorityIndex = 1
		if sliderSetters["Orbit Studs (Radio)"] then sliderSetters["Orbit Studs (Radio)"](7) end
		if sliderSetters["Orbit Speed"] then sliderSetters["Orbit Speed"](5) end
		if sliderSetters["Orbit Height Offset"] then sliderSetters["Orbit Height Offset"](0.5) end
		if setPriorityIndexVisual then setPriorityIndexVisual(1) end
		if updateOrbitBlockHitVisual then updateOrbitBlockHitVisual(true) end
		setOrbitState(true)
		notify("Preset: Legit Orbit", Color3.fromRGB(110, 235, 145))
	elseif presetName == "Rage" then
		setUeCounterState(false)
		config.TpOffsetX = 0
		config.TpOffsetY = 0
		config.TpOffsetZ = 2.5
		config.RagebotBlockHit = true
		config.TargetPriorityIndex = 2
		if sliderSetters["TP Offset X (Izq / Der)"] then sliderSetters["TP Offset X (Izq / Der)"](0) end
		if sliderSetters["TP Offset Y (Abajo / Arriba)"] then sliderSetters["TP Offset Y (Abajo / Arriba)"](0) end
		if sliderSetters["TP Offset Z (Atrás / Frente)"] then sliderSetters["TP Offset Z (Atrás / Frente)"](2.5) end
		if setPriorityIndexVisual then setPriorityIndexVisual(2) end
		if updateRagebotBlockHitVisual then updateRagebotBlockHitVisual(true) end
		setRagebotState(true)
		notify("Preset: Rage", Color3.fromRGB(255, 85, 85))
	elseif presetName == "Void" then
		setUeCounterState(false)
		config.MaxHeight = 50000
		config.MaxSpeed = 50000
		config.VoidAutoFire = true
		if sliderSetters["Altura (Studs)"] then sliderSetters["Altura (Studs)"](50000) end
		if sliderSetters["Velocidad (Speed)"] then sliderSetters["Velocidad (Speed)"](50000) end
		if updateVoidAutoFireVisual then updateVoidAutoFireVisual(true) end
		setVoidState(true)
		notify("Preset: Void", Color3.fromRGB(185, 130, 255))
	elseif presetName == "Reset Defaults" then
		setUeCounterState(false)
