local function createTab(name, isDefault)
	local tabBtn = Instance.new("TextButton")
	tabBtn.Size = UDim2.new(0, 94, 0, 32)
	tabBtn.BackgroundColor3 = isDefault and Color3.fromRGB(55, 110, 240) or Color3.fromRGB(32, 32, 38)
	tabBtn.Text = name
	tabBtn.TextColor3 = isDefault and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 175)
	tabBtn.Font = Enum.Font.GothamSemibold
	tabBtn.TextSize = 12
	tabBtn.Parent = Sidebar
	Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)

	local page = Instance.new("ScrollingFrame")
	page.Size = UDim2.new(1, 0, 1, 0)
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.ScrollBarThickness = 4
	page.Visible = isDefault
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.AutomaticCanvasSize = Enum.AutomaticSize.Y
	page.Parent = PagesContainer

	local pageLayout = Instance.new("UIListLayout")
	pageLayout.Padding = UDim.new(0, 8)
	pageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	pageLayout.Parent = page

	local pagePad = Instance.new("UIPadding")
	pagePad.PaddingTop = UDim.new(0, 10)
	pagePad.PaddingBottom = UDim.new(0, 12)
	pagePad.Parent = page

	tabs[name] = {Btn = tabBtn, Page = page}

	tabBtn.MouseButton1Click:Connect(function()
		for _, t in pairs(tabs) do
			t.Page.Visible = false
			t.Btn.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
			t.Btn.TextColor3 = Color3.fromRGB(160, 160, 175)
		end
		page.Visible = true
		tabBtn.BackgroundColor3 = Color3.fromRGB(55, 110, 240)
		tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end)

	return page
end

