		if config.OrbitEnabled then setOrbitState(false) end
	end

	config.VoidEnabled = state
	if updateVoidToggleVisual then
		updateVoidToggleVisual(state)
	end

	if config.VoidEnabled then
		startUpwardLoop()
		ensureFireLoop()
		refreshStatusText()
		notify("Void: ON", Color3.fromRGB(185, 130, 255))
	else
