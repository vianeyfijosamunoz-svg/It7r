local function notify(titleText, accentColor)
	if not config.NotificationsEnabled then return end
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, 0, 0, 32)
	card.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
	card.BackgroundTransparency = 0.1
	card.ZIndex = 31
	card.Parent = NotifContainer
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 7)

	local stroke = Instance.new("UIStroke")
	stroke.Color = accentColor or Color3.fromRGB(80, 130, 255)
	stroke.Thickness = 1.2
	stroke.Parent = card

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -16, 1, 0)
	lbl.Position = UDim2.new(0, 8, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = titleText
	lbl.TextColor3 = Color3.fromRGB(240, 240, 250)
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Font = Enum.Font.GothamSemibold
	lbl.TextSize = 12
	lbl.ZIndex = 32
	lbl.Parent = card

	task.delay(2.2, function()
		if card and card.Parent then
			local tween = TweenService:Create(card, TweenInfo.new(0.25), { BackgroundTransparency = 1 })
			local txtTween = TweenService:Create(lbl, TweenInfo.new(0.25), { TextTransparency = 1 })
			tween:Play()
			txtTween:Play()
			tween.Completed:Wait()
			if card and card.Parent then
				card:Destroy()
			end
		end
	end)
end

