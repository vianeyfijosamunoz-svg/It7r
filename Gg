local function isEnemy(player)
	if not player or player == lplr then return false end

	local duel = SpectateController.CurrentDuelSubject
	local localDueler = duel and duel:GetDueler(lplr)
	local localTeam = localDueler and localDueler:Get("TeamID") or nil
	if localTeam and duel and duel.Duelers then
		for _, dueler in duel.Duelers do
			if dueler.Player == player then
				local targetTeam = dueler:Get("TeamID")
				if targetTeam ~= nil then
					return targetTeam ~= localTeam
				end
			end
		end
	end

	local pTeam = player:GetAttribute("TeamID")
	local lTeam = lplr:GetAttribute("TeamID")
	if pTeam ~= nil and lTeam ~= nil then
		return tostring(pTeam) ~= tostring(lTeam)
	end

	if lplr.Team and player.Team then
		return lplr.Team ~= player.Team
	end

	return true
end

local function isTargetValid(player)
	if not player or not player.Parent or player == lplr then return false end
	if not isEnemy(player) then return false end
	local pChar = player.Character
	if not pChar or not pChar.Parent then return false end
	local pRoot = pChar:FindFirstChild("HumanoidRootPart")
	local pHead = pChar:FindFirstChild("Head")
	local pHum = pChar:FindFirstChildWhichIsA("Humanoid")
	if not pRoot or not pHead or not pHum then return false end
	if pHum.Health <= 0 or pHum:GetState() == Enum.HumanoidStateType.Dead then return false end
	return true
end

local function hasValidEnemyWithinRange(myPos, maxRange)
	if not myPos then return false end
	for _, player in ipairs(plrs:GetPlayers()) do
		if not isTargetValid(player) then continue end
		local pChar = player.Character
		local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
		if pRoot and (myPos - pRoot.Position).Magnitude <= maxRange then
			return true
		end
	end
	return false
end

local function getClosestTarget(myPos)
	local priority = PRIORITIES[config.TargetPriorityIndex] or "Closest"

	if lockedTarget and isTargetValid(lockedTarget) then
		if priority == "Locked" then
			local pChar = lockedTarget.Character
			local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
			local pHead = pChar and pChar:FindFirstChild("Head")
			if pRoot and pHead then
				return lockedTarget, pRoot, pHead
			end
		end
	else
		lockedTarget = nil
	end

	local bestPlayer, bestRoot, bestHead = nil, nil, nil
	local bestMetric = math.huge

	for _, player in ipairs(plrs:GetPlayers()) do
		if not isTargetValid(player) then continue end
		local pChar = player.Character
		local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
		local pHead = pChar and pChar:FindFirstChild("Head")
		local pHum = pChar:FindFirstChildWhichIsA("Humanoid")
		if not pRoot or not pHead or not pHum then continue end

		local metric
		if priority == "Lowest HP" then
			metric = pHum.Health
		else
			metric = myPos and (myPos - pRoot.Position).Magnitude or 0
		end

		if metric < bestMetric then
			bestMetric = metric
			bestPlayer = player
			bestRoot = pRoot
			bestHead = pHead
		end
	end

	if bestPlayer then
		lockedTarget = bestPlayer
	end

	return bestPlayer, bestRoot, bestHead
end

local function getValidSilentTargetPart(pChar)
	local cam = Workspace.CurrentCamera
	if not cam or not pChar then return nil end
	local chosenName = BODY_PARTS[config.BodyPartIndex] or "Head"
	local part = pChar:FindFirstChild(chosenName) or pChar:FindFirstChild("Head") or pChar:FindFirstChild("HumanoidRootPart")
	if not part or not part:IsA("BasePart") then return nil end

	if config.WallCheck then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { lplr.Character, cam }
		local origin = cam.CFrame.Position
		local direction = part.Position - origin
		local result = Workspace:Raycast(origin, direction, params)
		if result and not result.Instance:IsDescendantOf(pChar) then
			return nil
		end
	end

	return part
end

local function updateSilentAimTarget()
	local cam = Workspace.CurrentCamera
	if not cam then
		activeTargetPos = nil
		return
	end

	local colorName = FOV_COLOR_NAMES[config.FovColorIndex] or "Rainbow"
	local chosenColor = FOV_COLORS[colorName] or Color3.fromHSV((tick() % 5) / 5, 1, 1)
	local screenCenter = cam.ViewportSize / 2

	FovCircle.Visible = config.ShowFov
	if config.ShowFov then
		FovCircle.Size = UDim2.new(0, config.FovRadius * 2, 0, config.FovRadius * 2)
		FovStroke.Color = chosenColor
	end

	if not config.SilentAimEnabled or not getgenv().SilentAimEnabled then
		activeTargetPos = nil
		return
	end

	if math.random(1, 100) > config.HitChance then
		activeTargetPos = nil
		return
	end

	local bestPart = nil
	local shortestDist = math.huge
	local chosenName = BODY_PARTS[config.BodyPartIndex] or "Head"

	for _, plr in ipairs(plrs:GetPlayers()) do
		if not isTargetValid(plr) then continue end
		local pChar = plr.Character
		local candidate = pChar:FindFirstChild(chosenName) or pChar:FindFirstChild("Head") or pChar:FindFirstChild("HumanoidRootPart")
		if candidate and candidate:IsA("BasePart") then
			local distFromMe = (candidate.Position - cam.CFrame.Position).Magnitude
			local partPos, partOnScreen = cam:WorldToViewportPoint(candidate.Position)
			local fovDist = (Vector2.new(partPos.X, partPos.Y) - screenCenter).Magnitude

			if partOnScreen and distFromMe <= config.MaxDistance and fovDist <= config.FovRadius and fovDist < shortestDist then
				local validPart = getValidSilentTargetPart(pChar)
				if validPart then
					shortestDist = fovDist
					bestPart = validPart
				end
			end
		end
	end

	activeTargetPos = bestPart and bestPart.Position or nil
end

local function fireAtTarget(originPos, targetHead, itemId, startShootingEnum)
	if not targetHead or not targetHead.Parent then return end
	local targetPos = targetHead.Position
	local aimCF = CFrame.lookAt(originPos, targetPos)
	local targetCF = targetHead.CFrame

	local randomOffset = Vector3.new(
		(math.random() - 0.5) * 0.04,
		(math.random() - 0.5) * 0.04,
		(math.random() - 0.5) * 0.04
	)
	local aimedPos = targetPos + randomOffset
	local objSpaceHeadOffset = targetHead.CFrame:ToObjectSpace(CFrame.new(aimedPos))

	local cameradata = {
		[utf8.char(1)] = {
			[utf8.char(0)] = util:EncodeCFrame(aimCF),
			[utf8.char(1)] = util:EncodeCFrame(targetCF),
			[utf8.char(2)] = targetHead,
			[utf8.char(3)] = util:EncodeCFrame(objSpaceHeadOffset)
		}
	}

	repS.Remotes.Replication.Fighter.UseItem:FireServer(
		itemId,
		startShootingEnum,
		cameradata,
		nil
	)
end

local function isBlockHitActive()
	if config.UeCounterEnabled and config.UeBlockHit and getEquippedObjectId() ~= nil then
		return true
	end
	if config.VoidEnabled and config.VoidAutoFire then
		return true
	end
	if config.RagebotEnabled and config.RagebotBlockHit and getEquippedObjectId() ~= nil then
		return true
	end
	if config.OrbitEnabled and config.OrbitBlockHit and getEquippedObjectId() ~= nil then
		return true
	end
	return false
end

local function ensureFireLoop()
	if fireConn then return end
	local startShootingEnum = enum:ToEnum("StartShooting")

	fireConn = runS.Heartbeat:Connect(function()
		if not isBlockHitActive() then return end

		local currentChar = lplr.Character
		local myRoot = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
		if not myRoot then return end

		local itemId = getEquippedObjectId()
		if not itemId then return end

		local myPos = myRoot.Position
		local targetPlayer, _, targetHead = getClosestTarget(myPos)
		if not targetPlayer or not targetHead or not isTargetValid(targetPlayer) then return end

		for _ = 1, config.BurstsPerTick do
			if not isBlockHitActive() or not targetHead.Parent or not isTargetValid(targetPlayer) then break end
			fireAtTarget(myPos, targetHead, itemId, startShootingEnum)
		end
	end)
end

local function checkStopFireLoop()
	if not hasMovementModeActive() and fireConn then
		fireConn:Disconnect()
		fireConn = nil
	end
end

