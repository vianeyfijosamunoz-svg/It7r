			local hp = pHum and math.max(0, math.floor(pHum.Health)) or 0
			local maxHp = pHum and math.max(1, pHum.MaxHealth) or 100
			local pct = math.clamp(hp / maxHp, 0, 1)
			local dist = currentHrp and math.floor((currentHrp.Position - targetRoot.Position).Magnitude) or 0
			local teamAttr = targetPlayer:GetAttribute("TeamID")
			local teamStr = teamAttr ~= nil and tostring(teamAttr) or "Enemy"

			TargetHudFrame.Visible = true
			TargetNameLabel.Text = "Target: " .. targetPlayer.Name
			TargetMetaLabel.Text = string.format("HP: %d | Dist: %d | Team: %s", hp, dist, teamStr)
			TargetHpBarFill.Size = UDim2.new(pct, 0, 1, 0)
		else
			TargetHudFrame.Visible = false
		end
	end)
end

local function extremeUpwardLaunch(enabled)
	local currentChar = lplr.Character
	if not currentChar then return end

	local currentHrp = currentChar:FindFirstChild("HumanoidRootPart")
	if not currentHrp then return end

	if enabled then
		applyVoidSpam(currentChar, currentHrp, config.MaxHeight, config.MaxSpeed)
	else
		if not hasMovementModeActive() and not config.MiscNoClip then
			restoreCollisions()
		end
		currentHrp.AssemblyLinearVelocity = Vector3.zero
	end
end

local function startUpwardLoop()
	if voidConn then voidConn:Disconnect() end
	voidConn = runS.RenderStepped:Connect(function()
