	label.Text = text
	label.TextColor3 = Color3.fromRGB(230, 230, 240)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 12
	label.Parent = row

	local valLabel = Instance.new("TextLabel")
	valLabel.Size = UDim2.new(0, 75, 0, 22)
	valLabel.Position = UDim2.new(1, -85, 0, 4)
	valLabel.BackgroundTransparency = 1
	valLabel.Text = tostring(defaultVal)
	valLabel.TextColor3 = Color3.fromRGB(110, 180, 255)
	valLabel.TextXAlignment = Enum.TextXAlignment.Right
	valLabel.Font = Enum.Font.GothamBold
	valLabel.TextSize = 12
	valLabel.Parent = row

	local barBg = Instance.new("TextButton")
	barBg.Size = UDim2.new(1, -24, 0, 8)
	barBg.Position = UDim2.new(0, 12, 0, 32)
	barBg.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	barBg.Text = ""
	barBg.AutoButtonColor = false
	barBg.Parent = row
	Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

	local initPct = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)

	local barFill = Instance.new("Frame")
	barFill.Size = UDim2.new(initPct, 0, 1, 0)
	barFill.BackgroundColor3 = Color3.fromRGB(55, 110, 240)
	barFill.BorderSizePixel = 0
	barFill.Parent = barBg
	Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 14, 0, 14)
	knob.Position = UDim2.new(initPct, -7, 0.5, -7)
	knob.BackgroundColor3 = Color3.fromRGB(240, 240, 250)
	knob.Parent = barBg
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local factor = 10 ^ (decimals or 0)
	local sliding = false

	local function applyValue(rawVal, fireCallback)
		local clamped = math.clamp(rawVal, minVal, maxVal)
		local finalVal = math.floor(clamped * factor + 0.5) / factor
		local relX = (finalVal - minVal) / (maxVal - minVal)
		barFill.Size = UDim2.new(relX, 0, 1, 0)
		knob.Position = UDim2.new(relX, -7, 0.5, -7)
		valLabel.Text = decimals and decimals >= 2 and string.format("%." .. decimals .. "f", finalVal) or tostring(finalVal)
		if fireCallback then
			callback(finalVal)
		end
	end

	sliderSetters[text] = function(newVal)
		applyValue(newVal, true)
	end

	barBg.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			local relX = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
			applyValue(minVal + (maxVal - minVal) * relX, true)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local relX = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
			applyValue(minVal + (maxVal - minVal) * relX, true)
		end
	end)
end

