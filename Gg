local function getKeyName(keyCode)
	if not keyCode or keyCode == Enum.KeyCode.Unknown then
		return "NONE"
	end
	return keyCode.Name
end

local function hasMovementModeActive()
	return config.VoidEnabled or config.RagebotEnabled or config.OrbitEnabled or config.UeCounterEnabled
end

local function getEquippedObjectId()
	if not FighterController or not FighterController.LocalFighter then
		return nil
	end
	local item = FighterController.LocalFighter.EquippedItem
	if not item or typeof(item.Get) ~= "function" then
		return nil
	end
	local ok, objectId = pcall(function()
		return item:Get("ObjectID")
	end)
	if ok and objectId ~= nil and tostring(objectId) ~= "" then
		return objectId
	end
	return nil
end

local function restoreCollisions()
	for part, wasCollidable in pairs(savedCollisions) do
		if part and part.Parent then
			part.CanCollide = wasCollidable
		end
	end
	table.clear(savedCollisions)
end

local function applyNoClip(targetChar)
	if not targetChar then return end
	for _, part in ipairs(targetChar:GetDescendants()) do
		if part:IsA("BasePart") then
			if savedCollisions[part] == nil then
				savedCollisions[part] = part.CanCollide
			end
			part.CanCollide = false
		end
	end
end

local function applyVoidSpam(currentChar, currentHrp, heightVal, speedVal)
	applyNoClip(currentChar)
	currentHrp.AssemblyLinearVelocity = Vector3.new(0, speedVal or 999999999, 0)
	local targetY = heightVal or 999999999
	if currentHrp.Position.Y < targetY then
		currentHrp.CFrame = CFrame.new(currentHrp.Position.X, targetY, currentHrp.Position.Z) * currentHrp.CFrame.Rotation
	end
end

local function applyFov()
	local cam = Workspace.CurrentCamera
	if cam and config.FovChangerEnabled then
		cam.FieldOfView = config.FovVal
	end
end

local function syncFovLoop()
	if fovConn then
		fovConn:Disconnect()
		fovConn = nil
	end
	if config.FovChangerEnabled then
		applyFov()
		fovConn = runS.RenderStepped:Connect(applyFov)
	end
end

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	if config.FovChangerEnabled then
		applyFov()
	end
end)

