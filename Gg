local function applyUndergroundStep(currentChar, currentHrp)
	if not undergroundTargetCFrame then
		undergroundTargetCFrame = currentHrp.CFrame - Vector3.new(0, 5, 0)
	end
	for _, part in ipairs(currentChar:GetDescendants()) do
		if part:IsA("BasePart") then
			if savedCollisions[part] == nil then
				savedCollisions[part] = part.CanCollide
			end
			part.CanCollide = false
		end
	end
	undergroundTargetCFrame = undergroundTargetCFrame - Vector3.new(0, 0, 0)
	currentHrp.CFrame = undergroundTargetCFrame
	currentHrp.AssemblyLinearVelocity = Vector3.zero
	currentHrp.AssemblyAngularVelocity = Vector3.zero
end

local function startUeCounterLoop()
	if ueConn then ueConn:Disconnect() end
	ueConn = runS.Stepped:Connect(function()
		if not config.UeCounterEnabled then return end
		local currentChar = lplr.Character
		local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
		if not currentChar or not currentHrp then return end

		if not ueTargetCFrame then
			ueTargetCFrame = currentHrp.CFrame - Vector3.new(0, FIXED_UE_UNDERGROUND_DEPTH, 0)
		end

		for _, part in ipairs(currentChar:GetDescendants()) do
			if part:IsA("BasePart") then
				if savedCollisions[part] == nil then
					savedCollisions[part] = part.CanCollide
				end
				part.CanCollide = false
			end
		end

		ueTargetCFrame = ueTargetCFrame - Vector3.new(0, 0, 0)
		currentHrp.CFrame = ueTargetCFrame
		currentHrp.AssemblyLinearVelocity = Vector3.zero
		currentHrp.AssemblyAngularVelocity = Vector3.zero
		refreshStatusText()
	end)
end

local function startRagebotLoop()
	if rageConn then rageConn:Disconnect() end
	rageConn = runS.RenderStepped:Connect(function()
		if not config.RagebotEnabled then return end

		local currentChar = lplr.Character
		local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
		if not currentHrp then return end

		local itemId = getEquippedObjectId()
		if not itemId then
			undergroundTargetCFrame = nil
			setStatus("ragebot: waiting for weapon", Color3.fromRGB(255, 200, 70))
			return
		end

		local hasEnemyIn500 = config.UndergroundManipulation and hasValidEnemyWithinRange(currentHrp.Position, UNDERGROUND_TRIGGER_RANGE)
		local targetPlayer, targetRoot, targetHead = getClosestTarget(currentHrp.Position)

		if hasEnemyIn500 then
			local labelName = targetPlayer and targetPlayer.Name or "enemy"
			setStatus("ragebot: underground " .. labelName, Color3.fromRGB(255, 155, 70))
			applyUndergroundStep(currentChar, currentHrp)
		elseif targetPlayer and targetRoot and isTargetValid(targetPlayer) then
			undergroundTargetCFrame = nil
			setStatus("ragebot: killing " .. targetPlayer.Name, Color3.fromRGB(255, 85, 85))
			applyNoClip(currentChar)
			currentHrp.AssemblyLinearVelocity = Vector3.zero

			local tpCFrame = targetRoot.CFrame * CFrame.new(config.TpOffsetX, config.TpOffsetY, config.TpOffsetZ)
			local lookTarget = targetHead and targetHead.Position or targetRoot.Position
			currentHrp.CFrame = CFrame.lookAt(tpCFrame.Position, lookTarget)
		else
			undergroundTargetCFrame = nil
			lockedTarget = nil
			setStatus("ragebot: no targeting", Color3.fromRGB(160, 195, 255))
			applyVoidSpam(currentChar, currentHrp, 999999999, 999999999)
		end
	end)
end

local function startOrbitLoop()
	if orbitConn then orbitConn:Disconnect() end
	orbitConn = runS.RenderStepped:Connect(function(dt)
		if not config.OrbitEnabled then return end

		local currentChar = lplr.Character
		local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
		if not currentHrp then return end

		local itemId = getEquippedObjectId()
		if not itemId then
			setStatus("orbit: waiting for weapon", Color3.fromRGB(255, 200, 70))
			return
		end

		local targetPlayer, targetRoot, targetHead = getClosestTarget(currentHrp.Position)
		if targetPlayer and targetRoot and isTargetValid(targetPlayer) then
			setStatus("orbit: killing " .. targetPlayer.Name, Color3.fromRGB(110, 235, 145))
			applyNoClip(currentChar)
			currentHrp.AssemblyLinearVelocity = Vector3.zero

			orbitAngle += config.OrbitSpeed * math.min(dt, 0.05)
			local centerPos = targetRoot.Position
			local orbitPos = Vector3.new(
				centerPos.X + math.cos(orbitAngle) * config.OrbitRadius,
				centerPos.Y + config.OrbitHeightOffset,
				centerPos.Z + math.sin(orbitAngle) * config.OrbitRadius
			)
			local lookTarget = targetHead and targetHead.Position or targetRoot.Position
			currentHrp.CFrame = CFrame.lookAt(orbitPos, lookTarget)
		else
			lockedTarget = nil
			setStatus("orbit: no targeting", Color3.fromRGB(160, 195, 255))
			applyVoidSpam(currentChar, currentHrp, 999999999, 999999999)
		end
	end)
end

