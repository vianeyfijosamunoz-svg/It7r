local function triggerKeybind(action)
	if action == "MenuToggle" then
		setMenuVisible(not MainFrame.Visible)
	elseif action == "Void" then
		setVoidState(not config.VoidEnabled)
	elseif action == "VoidAutoFire" then
		config.VoidAutoFire = not config.VoidAutoFire
		if updateVoidAutoFireVisual then updateVoidAutoFireVisual(config.VoidAutoFire) end
		notify("Void AutoFire: " .. (config.VoidAutoFire and "ON" or "OFF"), Color3.fromRGB(185, 130, 255))
	elseif action == "Ragebot" then
		setRagebotState(not config.RagebotEnabled)
	elseif action == "RagebotBlockHit" then
		config.RagebotBlockHit = not config.RagebotBlockHit
		if updateRagebotBlockHitVisual then updateRagebotBlockHitVisual(config.RagebotBlockHit) end
		notify("Ragebot BlockHit: " .. (config.RagebotBlockHit and "ON" or "OFF"), Color3.fromRGB(255, 85, 85))
	elseif action == "UndergroundManipulation" then
		config.UndergroundManipulation = not config.UndergroundManipulation
		undergroundTargetCFrame = nil
		if updateUndergroundVisual then updateUndergroundVisual(config.UndergroundManipulation) end
		notify("Underground Manipulation: " .. (config.UndergroundManipulation and "ON" or "OFF"), Color3.fromRGB(255, 155, 70))
	elseif action == "Orbit" then
		setOrbitState(not config.OrbitEnabled)
	elseif action == "OrbitBlockHit" then
		config.OrbitBlockHit = not config.OrbitBlockHit
		if updateOrbitBlockHitVisual then updateOrbitBlockHitVisual(config.OrbitBlockHit) end
		notify("Orbit BlockHit: " .. (config.OrbitBlockHit and "ON" or "OFF"), Color3.fromRGB(110, 235, 145))
	elseif action == "UeCounter" then
		setUeCounterState(not config.UeCounterEnabled)
	elseif action == "UeBlockHit" then
		config.UeBlockHit = not config.UeBlockHit
		if updateUeBlockHitVisual then updateUeBlockHitVisual(config.UeBlockHit) end
		notify("UE BlockHit: " .. (config.UeBlockHit and "ON" or "OFF"), Color3.fromRGB(255, 175, 55))
	elseif action == "SilentAim" then
		setSilentAimState(not config.SilentAimEnabled)
	elseif action == "ShowFov" then
		config.ShowFov = not config.ShowFov
		FovCircle.Visible = config.ShowFov
		if updateShowFovVisual then updateShowFovVisual(config.ShowFov) end
		notify("Show FOV: " .. (config.ShowFov and "ON" or "OFF"), Color3.fromRGB(110, 180, 255))
	elseif action == "InfiniteJump" then
		config.InfiniteJump = not config.InfiniteJump
		if updateInfJumpVisual then updateInfJumpVisual(config.InfiniteJump) end
		notify("Infinite Jump: " .. (config.InfiniteJump and "ON" or "OFF"), Color3.fromRGB(110, 180, 255))
	elseif action == "MiscNoClip" then
		setNoClipState(not config.MiscNoClip)
		notify("NoClip: " .. (config.MiscNoClip and "ON" or "OFF"), Color3.fromRGB(110, 180, 255))
	elseif action == "FullBright" then
		setFullBrightState(not config.FullBright)
		notify("FullBright: " .. (config.FullBright and "ON" or "OFF"), Color3.fromRGB(110, 180, 255))
	elseif action == "WalkSpeed" then
		setWalkSpeedState(not config.WalkSpeedEnabled)
		notify("WalkSpeed: " .. (config.WalkSpeedEnabled and "ON" or "OFF"), Color3.fromRGB(110, 180, 255))
	elseif action == "JumpPower" then
		setJumpPowerState(not config.JumpPowerEnabled)
		notify("JumpPower: " .. (config.JumpPowerEnabled and "ON" or "OFF"), Color3.fromRGB(110, 180, 255))
	elseif action == "AntiAFK" then
		config.AntiAFK = not config.AntiAFK
		if updateAntiAfkVisual then updateAntiAfkVisual(config.AntiAFK) end
		notify("Anti-AFK: " .. (config.AntiAFK and "ON" or "OFF"), Color3.fromRGB(110, 180, 255))
	elseif action == "FovChanger" then
		setFovChangerState(not config.FovChangerEnabled)
		notify("FOV Changer: " .. (config.FovChangerEnabled and "ON" or "OFF"), Color3.fromRGB(110, 180, 255))
	elseif action == "ResetChar" then
		resetCharacter()
		notify("Character Reset", Color3.fromRGB(255, 200, 70))
	end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if listeningAction then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local chosenKey = (input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete)
				and Enum.KeyCode.Unknown
				or input.KeyCode
			config.Keybinds[listeningAction] = chosenKey
			local activeAction = listeningAction
			listeningAction = nil
			if keybindUpdaters[activeAction] then
				keybindUpdaters[activeAction]()
			end
			notify("Keybind [" .. activeAction .. "] -> " .. getKeyName(chosenKey), Color3.fromRGB(110, 180, 255))
		end
		return
	end

	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
		for action, boundKey in pairs(config.Keybinds) do
			if boundKey == input.KeyCode then
				triggerKeybind(action)
			end
		end
	end
end)

local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, idx)
	local cam = Workspace.CurrentCamera
	if config.SilentAimEnabled and getgenv().SilentAimEnabled and activeTargetPos and not checkcaller() and idx == "ViewportSize" and self == cam then
		local pos, on = cam:WorldToViewportPoint(activeTargetPos)
		if on then
			return Vector2.new(pos.X * 2, pos.Y * 2)
		end
	end
	return oldIndex(self, idx)
end))

